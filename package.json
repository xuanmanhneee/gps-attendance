{
  "name": "gps-attendance",
  "private": true,
  "version": "0.0.1",
  "packageManager": "pnpm@11.12.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "postinstall": "pnpm --filter @gps-attendance/shared-types build",
    "dev:server": "pnpm --filter server start:dev",
    "dev:admin": "pnpm --filter admin-dashboard dev",
    "dev:mobile": "pnpm --filter mobile-client start",
    "build:server": "pnpm --filter server build",
    "build:admin": "pnpm --filter admin-dashboard build",
    "build:shared": "pnpm --filter \"./packages/**\" build"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  }
}
