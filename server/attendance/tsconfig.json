{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolvePackageJsonExports": true,
    "esModuleInterop": true,
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "incremental": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": false,
    "strictNullChecks": true,
    "strictBindCallApply": false,
    "noFallthroughCasesInSwitch": false,
    "types": ["node", "jest"],
    "paths": {
      "@gps-attendance/shared": ["../../packages/shared/dist"],
      "#account/*": ["./src/account/*"],
      "#attendance-check-in/*": ["./src/attendance-check-in/*"],
      "#attendance-record/*": ["./src/attendance-record/*"],
      "#attendance-sessions/*": ["./src/attendance-sessions/*"],
      "#attendance-validation/*": ["./src/attendance-validation/*"],
      "#auth/*": ["./src/auth/*"],
      "#tag/*": ["./src/tags"],
      "#units/*": ["./src/units/*"],
      "#common/*": ["./src/common/*"],
      "#geo/*": ["./src/geo/*"],
      "#prisma/*": ["./src/prisma/*"],
      "#user/*": ["./src/users/*"],
      "#redis/*": ["./src/redis/*"],
      "#job-scheduler/*": ["./src/job-scheduler/*"]
    }
  },
  "include": ["src/**/*.ts"]
}
