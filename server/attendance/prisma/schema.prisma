// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/prisma/generated"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum AccountStatus {
  active
  locked
  disabled
}

enum UserRole {
  admin
  organizer
  participant
}

enum SessionStatus {
  pending
  open
  closed
  cancelled
}

enum AttendanceStatus {
  absent
  present
  late
  excused
}

model Account {
  id           Int           @id @default(autoincrement()) @map("id")
  username     String        @unique @map("username")
  passwordHash String        @map("password_hash")
  status       AccountStatus @default(active) @map("status")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  userId Int  @unique @map("user_id")
  user   User @relation(fields: [userId], references: [id])

  refreshSessions RefreshSession[]

  @@map("accounts")
}

model RefreshSession {
  id        String    @id @default(uuid()) @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  accountId Int       @map("account_id")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([expiresAt])
  @@map("refresh_sessions")
}

model Tag {
  id        Int      @id @default(autoincrement()) @map("id")
  name      String   @map("name") @db.VarChar(100)
  ownerId   Int      @map("owner_id")
  createdAt DateTime @default(now()) @map("created_at")

  users UserTag[]

  @@index([ownerId])
  @@map("tags")
}

model UserTag {
  tagId  Int @map("tag_id")
  userId Int @map("user_id")

  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([tagId, userId])
  @@index([userId])
  @@map("user_tags")
}

model Unit {
  id       Int    @id @default(autoincrement()) @map("id")
  parentId Int?   @map("parent_id")
  name     String @db.VarChar(150)
  level    Int

  parent   Unit?  @relation("UnitHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children Unit[] @relation("UnitHierarchy")
  users    User[]

  @@index([parentId])
  @@index([level])
  @@map("units")
}

model User {
  id        Int      @id @default(autoincrement()) @map("id")
  code      String   @unique @map("code")
  role      UserRole @map("role")
  fullname  String   @map("fullname")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  unitId Int  @map("unit_id")
  unit   Unit @relation(fields: [unitId], references: [id], onDelete: Restrict)

  account Account?

  createdSessions   AttendanceSession[] @relation("SessionCreator")
  attendanceRecords AttendanceRecord[]
  updatedRecords    AttendanceRecord[]  @relation("RecordUpdater")
  tags              UserTag[]

  @@index([role])
  @@index([unitId])
  @@map("users")
}

model AttendanceSession {
  id        Int           @id @default(autoincrement())
  title     String        @db.VarChar(255)
  latitude  Decimal       @db.Decimal(10, 7)
  longitude Decimal       @db.Decimal(10, 7)
  radius    Decimal       @db.Decimal(8, 2)
  openAt    DateTime      @map("open_at")
  closeAt   DateTime      @map("close_at")
  status    SessionStatus @default(pending)
  createdBy Int           @map("created_by")
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  creator           User               @relation("SessionCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  attendanceRecords AttendanceRecord[]

  @@index([createdBy])
  @@index([openAt, closeAt])
  @@map("attendance_sessions")
}

model AttendanceRecord {
  id             Int              @id @default(autoincrement())
  sessionId      Int              @map("session_id")
  userId         Int              @map("user_id")
  status         AttendanceStatus
  deviceId       String?          @map("device_id") @db.VarChar(255)
  checkedInAt    DateTime?        @map("checked_in_at")
  latitude       Decimal?         @db.Decimal(10, 7)
  longitude      Decimal?         @db.Decimal(10, 7)
  accuracy       Decimal?         @db.Decimal(8, 2)
  distanceMeters Decimal?         @map("distance_meters") @db.Decimal(8, 2)
  updatedBy      Int?             @map("updated_by")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  session AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  updater User?             @relation("RecordUpdater", fields: [updatedBy], references: [id], onDelete: SetNull)

  @@unique([sessionId, userId])
  @@index([userId, updatedAt])
  @@map("attendance_records")
}
