// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  admin
  lecturer
  student
}

enum AttendanceStatus {
  absent
  present
  late
  excused
}

model Account {
  id        Int      @id @default(autoincrement())
  username  String   @unique @db.VarChar(100)
  password  String   @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User?

  @@map("accounts")
}

model User {
  id                 Int                 @id @default(autoincrement())
  accountId          Int                 @unique @map("account_id")
  code               String              @unique @db.VarChar(50)
  role               Role
  fullname           String              @db.VarChar(150)
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  account            Account             @relation(fields: [accountId], references: [id], onDelete: Restrict)
  createdSessions    AttendanceSession[] @relation("SessionCreator")
  attendanceRecords AttendanceRecord[]
  updatedRecords    AttendanceRecord[]  @relation("RecordUpdater")
  attempts           AttendanceAttempt[]

  @@index([role])
  @@map("users")
}

model AttendanceSession {
  id                Int                @id @default(autoincrement())
  title             String             @db.VarChar(255)
  latitude          Decimal            @db.Decimal(10, 7)
  longitude         Decimal            @db.Decimal(10, 7)
  radius            Decimal            @db.Decimal(8, 2)
  openAt            DateTime           @map("open_at")
  closeAt           DateTime           @map("close_at")
  createdBy         Int                @map("created_by")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")
  creator           User               @relation("SessionCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  attendanceRecords AttendanceRecord[]
  attempts          AttendanceAttempt[]

  @@index([createdBy])
  @@index([openAt, closeAt])
  @@map("attendance_sessions")
}

model AttendanceRecord {
  id             Int               @id @default(autoincrement())
  sessionId      Int               @map("session_id")
  userId         Int               @map("user_id")
  status         AttendanceStatus
  deviceId       String?           @map("device_id") @db.VarChar(255)
  checkedInAt    DateTime?         @map("checked_in_at")
  latitude       Decimal?          @db.Decimal(10, 7)
  longitude      Decimal?          @db.Decimal(10, 7)
  accuracy       Decimal?          @db.Decimal(8, 2)
  distanceMeters Decimal?          @map("distance_meters") @db.Decimal(8, 2)
  updatedBy      Int?              @map("updated_by")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")
  session        AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user           User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  updater        User?             @relation("RecordUpdater", fields: [updatedBy], references: [id], onDelete: SetNull)

  @@unique([sessionId, userId])
  @@index([userId, updatedAt])
  @@map("attendance_records")
}

model AttendanceAttempt {
  id        Int               @id @default(autoincrement())
  sessionId Int               @map("session_id")
  userId    Int               @map("user_id")
  createdAt DateTime          @default(now()) @map("created_at")
  session   AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user      User              @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([sessionId, userId, createdAt])
  @@map("attendance_attempts")
}
