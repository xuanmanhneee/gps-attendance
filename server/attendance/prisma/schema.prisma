// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum AccountStatus {
  active
  locked
  disabled
}

enum Role {
  admin
  lecturer
  student
}

enum SessionStatus {
  draft
  pending
  open
  closed
  cancelled
}

enum AttendanceStatus {
  absent
  present
  late
  excused
}

enum AttendanceAttemptResult {
  APPROVED
  REVIEW
  REJECTED
}

model Account {
  id           Int           @id @default(autoincrement()) @map("id")
  userId       Int           @unique @map("user_id")
  username     String        @unique @db.VarChar(100)
  passwordHash String        @map("password_hash") @db.VarChar(255)
  status       AccountStatus @default(active) @map("status")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("accounts")
}

model Tag {
  id        Int      @id @default(autoincrement()) @map("id")
  name      String   @map("name") @db.VarChar(100)
  ownerId   Int      @map("owner_id")
  createdAt DateTime @default(now()) @map("created_at")

  users     UserTag[]

  @@index([ownerId])
  @@map("tags")
}

model UserTag {
  tagId  Int @map("tag_id")
  userId Int @map("user_id")

  tag    Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([tagId, userId])
  @@index([userId])
  @@map("user_tags")
}

model Unit {
  id       Int    @id @default(autoincrement()) @map("id")
  parentId Int?   @map("parent_id")
  name     String @db.VarChar(150)
  level    Int

  parent   Unit?  @relation("UnitHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children Unit[] @relation("UnitHierarchy")
  users    User[]

  @@index([parentId])
  @@index([level])
  @@map("units")
}

model User {
  id                 Int                 @id @default(autoincrement())
  code               String              @unique @db.VarChar(50)
  role               Role
  fullname           String              @db.VarChar(150)
  unitId             Int?                @map("unit_id")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")

  unit               Unit?               @relation(fields: [unitId], references: [id], onDelete: Restrict)
  account            Account?
  createdSessions    AttendanceSession[] @relation("SessionCreator")
  attendanceRecords  AttendanceRecord[]
  updatedRecords     AttendanceRecord[]  @relation("RecordUpdater")
  attempts           AttendanceAttempt[]
  tags               UserTag[]

  @@index([role])
  @@index([unitId])
  @@map("users")
}

model AttendanceSession {
  id                Int                @id @default(autoincrement())
  title             String             @db.VarChar(255)
  latitude          Decimal            @db.Decimal(10, 7)
  longitude         Decimal            @db.Decimal(10, 7)
  radius            Decimal            @db.Decimal(8, 2)
  openAt            DateTime           @map("open_at")
  closeAt           DateTime           @map("close_at")
  status            SessionStatus      @default(draft)
  createdBy         Int                @map("created_by")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")

  creator           User               @relation("SessionCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  attendanceRecords AttendanceRecord[]
  attempts          AttendanceAttempt[]

  @@index([createdBy])
  @@index([createdBy, openAt, closeAt])
  @@index([openAt, closeAt])
  @@map("attendance_sessions")
}

model AttendanceRecord {
  id             Int               @id @default(autoincrement())
  sessionId      Int               @map("session_id")
  userId         Int               @map("user_id")
  status         AttendanceStatus
  deviceId       String?           @map("device_id") @db.VarChar(255)
  checkedInAt    DateTime?         @map("checked_in_at")
  latitude       Decimal?          @db.Decimal(10, 7)
  longitude      Decimal?          @db.Decimal(10, 7)
  accuracy       Decimal?          @db.Decimal(8, 2)
  distanceMeters Decimal?          @map("distance_meters") @db.Decimal(8, 2)
  updatedBy      Int?              @map("updated_by")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  session        AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user           User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  updater        User?             @relation("RecordUpdater", fields: [updatedBy], references: [id], onDelete: SetNull)

  @@unique([sessionId, userId])
  @@index([sessionId, deviceId])
  @@index([userId, updatedAt])
  @@map("attendance_records")
}

model AttendanceAttempt {
  id               Int                      @id @default(autoincrement())
  sessionId        Int                      @map("session_id")
  userId           Int                      @map("user_id")
  latitude         Decimal                  @db.Decimal(10, 7)
  longitude        Decimal                  @db.Decimal(10, 7)
  accuracy         Decimal                  @db.Decimal(8, 2)
  distanceToCenter Decimal                  @map("distance_to_center") @db.Decimal(8, 2)
  deviceId         String                   @map("device_id") @db.VarChar(255)
  isMockLocation   Boolean                  @map("is_mock_location")
  serverTimestamp  DateTime                 @default(now()) @map("server_timestamp")
  result           AttendanceAttemptResult?
  reasons          String[]                 @default([])
  createdAt        DateTime                 @default(now()) @map("created_at")

  session          AttendanceSession        @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user             User                     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([sessionId, userId, createdAt])
  @@index([sessionId, deviceId, createdAt])
  @@index([sessionId, userId, serverTimestamp])
  @@map("attendance_attempts")
}
