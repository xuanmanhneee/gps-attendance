// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum AccountStatus {
  active
  locked
  disabled
}

enum Role {
  admin
  organizer
  participant
}

enum SessionStatus {
  draft
  pending
  open
  closed
  cancelled
}

enum RegistryLocationType {
  BUILDING
  FACILITY
}

enum RegistryLocationStatus {
  ACTIVE
  INACTIVE
}

enum RoomStatus {
  ACTIVE
  INACTIVE
}

enum SessionLocationSource {
  MANUAL
  BUILDING_REGISTRY
}

enum LecturerLocationVerificationStatus {
  PASS
  WARNING
}

enum AttendanceStatus {
  absent
  present
  late
  excused
}

enum AttendanceAttemptResult {
  APPROVED
  REVIEW
  REJECTED
}

enum AttendanceHistoryEventType {
  SESSION_CREATED
  SESSION_ASSIGNED
  CHECK_IN_ATTEMPT
  GPS_VALIDATED
  GPS_REVIEW
  GPS_REJECTED
  DEVICE_REJECTED
  ATTEMPT_REJECTED
  REVIEW_DECISION
  RECORD_UPDATED
}

enum EnrollmentStatus {
  active
  withdrawn
  completed
}

enum NotificationType {
  SESSION_ASSIGNED
  SESSION_OPENED
  CHECK_IN_RESULT
  REVIEW_DECISION
  ATTENDANCE_REMINDER
  SYSTEM
}

enum DeviceTrustStatus {
  UNVERIFIED
  TRUSTED
  BLOCKED
}

enum IntegrityProvider {
  PLAY_INTEGRITY
  APP_ATTEST
}

model Account {
  id           Int           @id @default(autoincrement()) @map("id")
  userId       Int           @unique @map("user_id")
  username     String        @unique @db.VarChar(100)
  passwordHash String        @map("password_hash") @db.VarChar(255)
  status       AccountStatus @default(active) @map("status")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshSessions RefreshSession[]

  @@map("accounts")
}

model RefreshSession {
  id        String    @id @default(uuid()) @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  accountId Int       @map("account_id")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  account   Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([expiresAt])
  @@map("refresh_sessions")
}

model Tag {
  id        Int      @id @default(autoincrement()) @map("id")
  name      String   @map("name") @db.VarChar(100)
  ownerId   Int      @map("owner_id")
  createdAt DateTime @default(now()) @map("created_at")

  users     UserTag[]

  @@index([ownerId])
  @@map("tags")
}

model UserTag {
  tagId  Int @map("tag_id")
  userId Int @map("user_id")

  tag    Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([tagId, userId])
  @@index([userId])
  @@map("user_tags")
}

model Unit {
  id       Int    @id @default(autoincrement()) @map("id")
  parentId Int?   @map("parent_id")
  name     String @db.VarChar(150)
  level    Int

  parent   Unit?  @relation("UnitHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children Unit[] @relation("UnitHierarchy")
  users    User[]
  courses  Course[]

  @@index([parentId])
  @@index([level])
  @@map("units")
}

model User {
  id                         Int                        @id @default(autoincrement())
  code                       String                     @unique @db.VarChar(50)
  role                       Role
  fullname                   String                     @db.VarChar(150)
  unitId                     Int?                       @map("unit_id")
  email                      String?                    @db.VarChar(254)
  phone                      String?                    @db.VarChar(30)
  dateOfBirth                String?                    @map("date_of_birth") @db.VarChar(10)
  gender                     String?                    @db.VarChar(30)
  address                    String?                    @db.VarChar(255)
  programName                String?                    @map("program_name") @db.VarChar(150)
  cohort                     String?                    @db.VarChar(50)
  studyMode                  String?                    @map("study_mode") @db.VarChar(50)
  createdAt                  DateTime                   @default(now()) @map("created_at")
  updatedAt                  DateTime                   @updatedAt @map("updated_at")

  unit                       Unit?                      @relation(fields: [unitId], references: [id], onDelete: Restrict)
  account                    Account?
  taughtSections             CourseSection[]            @relation("SectionLecturer")
  classEnrollments           ClassEnrollment[]
  notificationsCreated       Notification[]             @relation("NotificationCreator")
  notificationStates         UserNotificationState[]
  pushTokens                 PushToken[]
  registeredDevices          RegisteredDevice[]
  integrityChecks            DeviceIntegrityCheck[]
  auditLogs                  AuditLog[]                 @relation("AuditActor")
  createdSessions            AttendanceSession[]        @relation("SessionCreator")
  attendanceRecords          AttendanceRecord[]
  updatedRecords             AttendanceRecord[]        @relation("RecordUpdater")
  attempts                   AttendanceAttempt[]
  reviewedAttempts           AttendanceAttempt[]        @relation("AttemptReviewer")
  lecturerLocationVerifications LecturerLocationVerification[]
  attendanceHistoryEvents    AttendanceHistoryEvent[]   @relation("AttendanceHistorySubject")
  actedAttendanceHistoryEvents AttendanceHistoryEvent[]  @relation("AttendanceHistoryActor")
  tags                       UserTag[]

  @@index([role])
  @@index([unitId])
  @@index([role, unitId])
  @@map("users")
}

model Campus {
  id        Int        @id @default(autoincrement())
  code      String     @unique @db.VarChar(50)
  name      String     @db.VarChar(150)
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  buildings Building[]

  @@map("campuses")
}

model Building {
  id                   Int                    @id @default(autoincrement())
  campusId             Int                    @map("campus_id")
  code                 String                 @unique @db.VarChar(50)
  name                 String                 @db.VarChar(150)
  latitude             Decimal                @db.Decimal(10, 7)
  longitude            Decimal                @db.Decimal(10, 7)
  geofenceRadius       Decimal?               @map("geofence_radius") @db.Decimal(8, 2)
  gpsAccuracyThreshold Decimal?               @map("gps_accuracy_threshold") @db.Decimal(8, 2)
  lecturerValidationRadius Decimal?            @map("lecturer_validation_radius") @db.Decimal(8, 2)
  type                 RegistryLocationType
  verified             Boolean                @default(false)
  status               RegistryLocationStatus @default(ACTIVE)
  createdAt            DateTime               @default(now()) @map("created_at")
  updatedAt            DateTime               @updatedAt @map("updated_at")

  campus             Campus              @relation(fields: [campusId], references: [id], onDelete: Restrict)
  rooms              Room[]
  attendanceSessions AttendanceSession[]

  @@index([campusId, type, status])
  @@map("buildings")
}

model AttendanceSession {
  id                Int                @id @default(autoincrement())
  title             String             @db.VarChar(255)
  latitude          Decimal            @db.Decimal(10, 7)
  longitude         Decimal            @db.Decimal(10, 7)
  radius            Decimal            @db.Decimal(8, 2)
  gpsAccuracyThreshold Decimal?         @map("gps_accuracy_threshold") @db.Decimal(8, 2)
  lecturerValidationRadius Decimal?     @map("lecturer_validation_radius") @db.Decimal(8, 2)
  openAt            DateTime           @map("open_at")
  closeAt           DateTime           @map("close_at")
  status            SessionStatus      @default(draft)
  createdBy         Int                @map("created_by")
  courseSectionId   Int?               @map("course_section_id")
  buildingId        Int?               @map("building_id")
  roomId            Int?               @map("room_id")
  timetableSlotId   Int?               @map("timetable_slot_id")
  locationSource    SessionLocationSource @default(MANUAL) @map("location_source")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")

  creator           User               @relation("SessionCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  courseSection     CourseSection?     @relation(fields: [courseSectionId], references: [id], onDelete: SetNull)
  building          Building?          @relation(fields: [buildingId], references: [id], onDelete: SetNull)
  room              Room?              @relation(fields: [roomId], references: [id], onDelete: SetNull)
  timetableSlot     TimetableSlot?     @relation(fields: [timetableSlotId], references: [id], onDelete: SetNull)
  attendanceRecords AttendanceRecord[]
  attempts          AttendanceAttempt[]
  historyEvents     AttendanceHistoryEvent[]
  integrityChecks   DeviceIntegrityCheck[]
  notifications     Notification[]
  lecturerLocationVerifications LecturerLocationVerification[]

  @@index([createdBy])
  @@index([createdBy, openAt, closeAt])
  @@index([courseSectionId])
  @@index([buildingId])
  @@index([roomId])
  @@index([timetableSlotId])
  @@index([openAt, closeAt])
  @@map("attendance_sessions")
}

model AttendanceRecord {
  id             Int               @id @default(autoincrement())
  sessionId      Int               @map("session_id")
  userId         Int               @map("user_id")
  status         AttendanceStatus
  deviceId       String?           @map("device_id") @db.VarChar(255)
  checkedInAt    DateTime?         @map("checked_in_at")
  latitude       Decimal?          @db.Decimal(10, 7)
  longitude      Decimal?          @db.Decimal(10, 7)
  accuracy       Decimal?          @db.Decimal(8, 2)
  distanceMeters Decimal?          @map("distance_meters") @db.Decimal(8, 2)
  updatedBy      Int?              @map("updated_by")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  session        AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user           User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  updater        User?             @relation("RecordUpdater", fields: [updatedBy], references: [id], onDelete: SetNull)

  @@unique([sessionId, userId])
  @@index([sessionId, deviceId])
  @@index([sessionId, status, checkedInAt])
  @@index([userId, updatedAt])
  @@map("attendance_records")
}

model AttendanceAttempt {
  id               Int                      @id @default(autoincrement())
  queueId          String?                  @unique @map("queue_id") @db.Uuid
  sessionId        Int                      @map("session_id")
  userId           Int                      @map("user_id")
  latitude         Decimal                  @db.Decimal(10, 7)
  longitude        Decimal                  @db.Decimal(10, 7)
  accuracy         Decimal                  @db.Decimal(8, 2)
  distanceToCenter Decimal                  @map("distance_to_center") @db.Decimal(8, 2)
  deviceId         String                   @map("device_id") @db.VarChar(255)
  isMockLocation   Boolean                  @map("is_mock_location")
  serverTimestamp  DateTime                 @default(now()) @map("server_timestamp")
  result           AttendanceAttemptResult?
  reasons          String[]                 @default([])
  reviewedBy       Int?                     @map("reviewed_by")
  reviewedAt       DateTime?                @map("reviewed_at")
  reviewNote       String?                  @map("review_note") @db.VarChar(500)
  reviewReason     String?                  @map("review_reason") @db.VarChar(50)
  createdAt        DateTime                 @default(now()) @map("created_at")

  session          AttendanceSession        @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user             User                     @relation(fields: [userId], references: [id], onDelete: Restrict)
  reviewer         User?                    @relation("AttemptReviewer", fields: [reviewedBy], references: [id], onDelete: SetNull)
  historyEvents    AttendanceHistoryEvent[]

  @@index([sessionId, userId, createdAt])
  @@index([sessionId, deviceId, createdAt])
  @@index([sessionId, userId, serverTimestamp])
  @@index([userId, result, createdAt])
  @@map("attendance_attempts")
}

model AttendanceHistoryEvent {
  id            Int                        @id @default(autoincrement())
  sourceKey     String?                    @unique @map("source_key") @db.VarChar(100)
  sessionId     Int                        @map("session_id")
  userId        Int                        @map("user_id")
  actorId       Int?                       @map("actor_id")
  attemptId     Int?                       @map("attempt_id")
  eventType     AttendanceHistoryEventType @map("event_type")
  status        AttendanceStatus?
  attemptResult AttendanceAttemptResult?   @map("attempt_result")
  reasons       String[]                   @default([])
  reviewReason  String?                    @map("review_reason") @db.VarChar(50)
  note          String?                    @db.VarChar(500)
  createdAt     DateTime                   @default(now()) @map("created_at")

  session AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User              @relation("AttendanceHistorySubject", fields: [userId], references: [id], onDelete: Cascade)
  actor   User?             @relation("AttendanceHistoryActor", fields: [actorId], references: [id], onDelete: SetNull)
  attempt AttendanceAttempt? @relation(fields: [attemptId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([sessionId, userId, createdAt])
  @@index([attemptId])
  @@map("attendance_history_events")
}

model LecturerLocationVerification {
  id             Int                                @id @default(autoincrement())
  sessionId      Int                                @map("session_id")
  lecturerId     Int                                @map("lecturer_id")
  latitude       Decimal                            @db.Decimal(10, 7)
  longitude      Decimal                            @db.Decimal(10, 7)
  accuracy       Decimal                            @db.Decimal(8, 2)
  clientTimestamp DateTime                          @map("client_timestamp")
  serverTimestamp DateTime                          @default(now()) @map("server_timestamp")
  distanceMeters Decimal                            @map("distance_meters") @db.Decimal(8, 2)
  status         LecturerLocationVerificationStatus
  reasons        String[]                           @default([])
  createdAt      DateTime                           @default(now()) @map("created_at")

  session  AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  lecturer User              @relation(fields: [lecturerId], references: [id], onDelete: Restrict)

  @@index([sessionId, createdAt])
  @@index([lecturerId, createdAt])
  @@map("lecturer_location_verifications")
}

model AcademicTerm {
  id           Int             @id @default(autoincrement())
  name         String          @db.VarChar(100)
  academicYear String          @map("academic_year") @db.VarChar(20)
  semester     Int
  startDate    DateTime        @map("start_date") @db.Date
  endDate      DateTime        @map("end_date") @db.Date
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")

  sections     CourseSection[]

  @@unique([academicYear, semester])
  @@map("academic_terms")
}

model Course {
  id          Int             @id @default(autoincrement())
  code        String          @unique @db.VarChar(30)
  name        String          @db.VarChar(180)
  credits     Int?
  unitId      Int?            @map("unit_id")
  isActive    Boolean         @default(true) @map("is_active")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  unit        Unit?           @relation(fields: [unitId], references: [id], onDelete: SetNull)
  sections    CourseSection[]

  @@index([unitId])
  @@map("courses")
}

model Room {
  id        Int             @id @default(autoincrement())
  code      String          @unique @db.VarChar(50)
  name      String          @db.VarChar(100)
  building  String?         @db.VarChar(100)
  buildingId Int?           @map("building_id")
  floor     String?         @db.VarChar(30)
  status    RoomStatus      @default(ACTIVE)
  latitude  Decimal?        @db.Decimal(10, 7)
  longitude Decimal?        @db.Decimal(10, 7)
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")

  sections  CourseSection[]
  slots     TimetableSlot[]
  registryBuilding Building? @relation(fields: [buildingId], references: [id], onDelete: SetNull)
  attendanceSessions AttendanceSession[]

  @@index([buildingId, floor, status])
  @@map("rooms")
}

model CourseSection {
  id         Int             @id @default(autoincrement())
  code       String          @db.VarChar(50)
  courseId   Int             @map("course_id")
  termId     Int             @map("term_id")
  lecturerId Int?            @map("lecturer_id")
  roomId     Int?            @map("room_id")
  capacity   Int?
  createdAt  DateTime        @default(now()) @map("created_at")
  updatedAt  DateTime        @updatedAt @map("updated_at")

  course     Course          @relation(fields: [courseId], references: [id], onDelete: Restrict)
  term       AcademicTerm    @relation(fields: [termId], references: [id], onDelete: Restrict)
  lecturer   User?           @relation("SectionLecturer", fields: [lecturerId], references: [id], onDelete: SetNull)
  room       Room?           @relation(fields: [roomId], references: [id], onDelete: SetNull)
  enrollments ClassEnrollment[]
  timetable  TimetableSlot[]
  attendanceSessions AttendanceSession[]

  @@unique([termId, code])
  @@index([courseId])
  @@index([lecturerId])
  @@index([roomId])
  @@map("course_sections")
}

model ClassEnrollment {
  courseSectionId Int             @map("course_section_id")
  userId          Int             @map("user_id")
  status          EnrollmentStatus @default(active)
  enrolledAt      DateTime        @default(now()) @map("enrolled_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  courseSection   CourseSection   @relation(fields: [courseSectionId], references: [id], onDelete: Cascade)
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([courseSectionId, userId])
  @@index([courseSectionId, status])
  @@index([userId, status])
  @@map("class_enrollments")
}

model TimetableSlot {
  id              Int           @id @default(autoincrement())
  courseSectionId Int           @map("course_section_id")
  dayOfWeek       Int           @map("day_of_week")
  scheduledDate   DateTime?       @map("scheduled_date") @db.Date
  startMinute     Int             @map("start_minute")
  endMinute       Int           @map("end_minute")
  roomId          Int?          @map("room_id")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  courseSection   CourseSection @relation(fields: [courseSectionId], references: [id], onDelete: Cascade)
  room            Room?         @relation(fields: [roomId], references: [id], onDelete: SetNull)
  attendanceSessions AttendanceSession[]

  @@index([courseSectionId, dayOfWeek])
  @@index([roomId, dayOfWeek])
  @@map("timetable_slots")
}

model Notification {
  id          Int               @id @default(autoincrement())
  type        NotificationType
  title       String            @db.VarChar(180)
  message     String            @db.VarChar(1000)
  sessionId   Int?              @map("session_id")
  createdBy   Int?              @map("created_by")
  createdAt   DateTime          @default(now()) @map("created_at")

  session     AttendanceSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  creator     User?             @relation("NotificationCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  recipients  UserNotificationState[]

  @@index([createdAt])
  @@index([sessionId])
  @@map("notifications")
}

model UserNotificationState {
  notificationId Int          @map("notification_id")
  userId         Int          @map("user_id")
  readAt         DateTime?    @map("read_at")
  deliveredAt    DateTime?    @map("delivered_at")
  createdAt      DateTime     @default(now()) @map("created_at")

  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([notificationId, userId])
  @@index([userId, readAt, createdAt])
  @@map("user_notification_states")
}

model PushToken {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  token     String   @unique @db.VarChar(512)
  platform  String   @db.VarChar(20)
  deviceId  String?  @map("device_id") @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_tokens")
}

model RegisteredDevice {
  id          Int              @id @default(autoincrement())
  userId      Int              @map("user_id")
  deviceId    String           @map("device_id") @db.VarChar(255)
  platform    String           @db.VarChar(20)
  model       String?          @db.VarChar(150)
  trustStatus DeviceTrustStatus @default(UNVERIFIED) @map("trust_status")
  firstSeenAt DateTime         @default(now()) @map("first_seen_at")
  lastSeenAt  DateTime         @default(now()) @map("last_seen_at")
  blockedAt   DateTime?        @map("blocked_at")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  integrityChecks DeviceIntegrityCheck[]

  @@unique([userId, deviceId])
  @@index([trustStatus])
  @@map("registered_devices")
}

model DeviceIntegrityCheck {
  id                 Int               @id @default(autoincrement())
  sourceKey          String?           @unique @map("source_key") @db.VarChar(100)
  userId             Int               @map("user_id")
  registeredDeviceId Int?              @map("registered_device_id")
  sessionId          Int?              @map("session_id")
  provider           IntegrityProvider
  verdict            String            @db.VarChar(50)
  reasons            String[]          @default([])
  checkedAt          DateTime          @default(now()) @map("checked_at")

  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  registeredDevice   RegisteredDevice? @relation(fields: [registeredDeviceId], references: [id], onDelete: SetNull)
  session            AttendanceSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([userId, checkedAt])
  @@index([registeredDeviceId, checkedAt])
  @@index([sessionId])
  @@map("device_integrity_checks")
}

model AuditLog {
  id          Int       @id @default(autoincrement())
  sourceKey   String?   @unique @map("source_key") @db.VarChar(100)
  actorUserId Int?      @map("actor_user_id")
  action      String    @db.VarChar(100)
  entityType  String    @map("entity_type") @db.VarChar(100)
  entityId    String?   @map("entity_id") @db.VarChar(100)
  metadata    Json?
  requestId   String?   @map("request_id") @db.VarChar(100)
  createdAt   DateTime  @default(now()) @map("created_at")

  actor       User?     @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId, createdAt])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}
