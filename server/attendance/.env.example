JWT_SECRET=
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/gps_attendance"
# Số kết nối PostgreSQL tối đa mỗi instance (mặc định 15)
DB_POOL_MAX=15
# Hàng đợi kết nối TCP chờ accept (mặc định 4096, bị giới hạn bởi somaxconn)
HTTP_BACKLOG=4096

# --- Bảo mật ---
# JWT_SECRET: tối thiểu 32 ký tự; production từ chối khởi động nếu ngắn hơn.
# CORS_ORIGINS: danh sách origin được phép, cách nhau bằng dấu phẩy
# (vd https://dashboard.example.edu). Để trống: dev cho mọi origin, production tắt CORS.
CORS_ORIGINS=
# Số hop proxy tin cậy (vd 1 khi sau một nginx) để req.ip là IP client thật.
TRUST_PROXY=
# Production mặc định tắt /api-docs; đặt true để bật lại.
ENABLE_SWAGGER=false

# --- Giới hạn tốc độ đăng nhập (xem docs/api.md) ---
LOGIN_MAX_FAILURES=10
LOGIN_FAILURE_WINDOW_SEC=300
AUTH_IP_LIMIT_PER_MIN=1000

# Số thread libuv cho bcrypt (mặc định Node là 4). Phải là biến môi trường của
# tiến trình (Docker/compose/shell), không có tác dụng nếu chỉ ghi trong .env
# vì Node đọc nó trước khi nạp file. Đặt xấp xỉ số CPU của container.
# UV_THREADPOOL_SIZE=8
