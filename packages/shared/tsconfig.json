    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,

    "outDir": "dist",
    "rootDir": "src",

    "module": "node16",
    "moduleResolution": "node16",
    "target": "ES2020",

    "strict": true,
    "skipLibCheck": true
  },
  "include": ["src"]
}